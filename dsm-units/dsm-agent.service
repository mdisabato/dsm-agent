[Unit]
Description=DSM Agent - System Monitoring
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=root
ExecStart=/volume1/@appstore/python314/bin/python3.14 /volume1/IoTdata/dsm-agent/dsm-agent.py
WorkingDirectory=/volume1/IoTdata/dsm-agent
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
